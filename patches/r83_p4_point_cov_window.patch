+// R83 (option B). Window relative-pose covariance. For step k with head time t_k, the (R,P) block of the noise accrued over the
+// steps whose heads lie in [t_k - W/2, t_k + W/2), clipped to the scan and always containing step k itself:
+//     S <- F_j S F_j^T + Q_j  for j = ka..kb-1 (S starts at zero),  out[k] = S.block<6,6>(idx_r, idx_r).
+// Forward accumulation, exact for the stated window; cost O(n_steps * steps_in_window) dim x dim products, once per scan.
+inline std::vector<Eigen::Matrix<double, 6, 6>> relCovWindowBlocks(
+    const std::vector<Eigen::MatrixXd>& F, const std::vector<Eigen::MatrixXd>& Q, const std::vector<double>& head_times,
+    double window_s, int idx_r)
+{
+  const std::size_t n = F.size();
+  std::vector<Eigen::Matrix<double, 6, 6>> out(n, Eigen::Matrix<double, 6, 6>::Zero());
+  if (n == 0 || Q.size() != n || head_times.size() != n || !(window_s > 0.0)) return out;
+  const int dim = static_cast<int>(F[0].rows());
+  const double half = 0.5 * window_s;
+  Eigen::MatrixXd S(dim, dim);
+  std::size_t ka = 0, kb = 0;
+  for (std::size_t k = 0; k < n; ++k)
+  {
+    while (ka < k && head_times[ka] < head_times[k] - half) ++ka;
+    if (kb < k + 1) kb = k + 1;
+    while (kb < n && head_times[kb] < head_times[k] + half) ++kb;
+    S.setZero();
+    for (std::size_t j = ka; j < kb; ++j) S = F[j] * S * F[j].transpose() + Q[j];
+    out[k] = S.block<6, 6>(idx_r, idx_r);
+  }
+  return out;
+}
+
 }  // namespace livo_recon
