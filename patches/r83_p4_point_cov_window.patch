+M3D StateGroup::windowCovAtPoint(const V3D& p_body, double t_point) const
+{
+  if (!(point_cov_window_s_ > 0.0) || win_head_times_.empty() || win_blocks_.size() != win_head_times_.size())
+    return M3D::Zero();
+  const auto it = std::upper_bound(win_head_times_.begin(), win_head_times_.end(), t_point);
+  const std::size_t k = (it == win_head_times_.begin()) ? 0 : static_cast<std::size_t>(it - win_head_times_.begin()) - 1;
+  const auto& B = win_blocks_[k];
+  return poseCovFromBlocks(rot_, p_body, B.block<3,3>(0,0), B.block<3,3>(3,3), B.block<3,3>(0,3));
+}
