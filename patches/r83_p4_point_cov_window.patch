diff -urN -x __pycache__ a/tests/test_point_cov_window_r83.cpp b/tests/test_point_cov_window_r83.cpp
--- a/tests/test_point_cov_window_r83.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/tests/test_point_cov_window_r83.cpp	2026-10-07 01:25:43.622494425 -0700
@@ -0,0 +1,112 @@
+// R83 unit test (option B): window relative-pose covariance.
+//   W1 relCovWindowBlocks equals an independent forward simulation over the window [t_k - W/2, t_k + W/2) (clipped, containing k).
+//   W2 window larger than the scan: every block equals the full-scan forward simulation from the first step.
+//   W3 window_s <= 0 or size mismatch: all blocks zero.
+//   W4 windowCovAtPoint with the window off returns exactly zero; with it on equals an independent J B J^T for the block
+//      selected by time (before first head -> block 0, in [head_k, head_k+1) -> block k, after last -> last).
+//   W5 block symmetric and PSD (min eigenvalue >= -1e-15) for every k.
+//   W6 windowCovAtPoint never reads rel_blocks_ / the R65 profile (set a huge R65 profile; result unchanged).
+#include <ros/ros.h>
+#define private public
+#include "livo_recon/utils/state/state.h"
+#undef private
+#include "livo_recon/utils/state/rel_cov.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+
+#define CHECK(c, msg)                                                                       \
+  do {                                                                                      \
+    if (!(c)) { std::fprintf(stderr, "[FAIL] %s  (%s:%d: %s)\n", msg, __FILE__, __LINE__, #c); std::exit(1); } \
+    else { std::printf("[PASS] %s\n", msg); }                                               \
+  } while (0)
+
+using namespace livo_recon;
+using M6 = Eigen::Matrix<double, 6, 6>;
+
+namespace {
+M3D skew(const V3D& v) { M3D k; k << 0, -v.z(), v.y(), v.z(), 0, -v.x(), -v.y(), v.x(), 0; return k; }
+M3D jbj(const M3D& R, const V3D& p, const M6& B)
+{
+  Eigen::Matrix<double, 3, 6> J; J.block<3,3>(0,0) = -R * skew(p); J.block<3,3>(0,3) = M3D::Identity();
+  return J * B * J.transpose();
+}
+}  // namespace
+
+int main()
+{
+  std::mt19937 rng(11);
+  std::normal_distribution<double> N(0, 1);
+  const int dim = 18, n = 12, idxR = 0;
+  const double dt = 0.005;
+  std::vector<Eigen::MatrixXd> F(n), Q(n);
+  std::vector<double> ht(n);
+  for (int k = 0; k < n; ++k) {
+    ht[k] = 0.100 + k * dt;
+    F[k] = Eigen::MatrixXd::Identity(dim, dim) + 0.05 * Eigen::MatrixXd::NullaryExpr(dim, dim, [&]() { return N(rng); });
+    Eigen::MatrixXd A = Eigen::MatrixXd::NullaryExpr(dim, dim, [&]() { return N(rng); });
+    Q[k] = 1e-4 * (A * A.transpose());
+  }
+  auto indep = [&](int k, double W) {
+    const double half = 0.5 * W;
+    int ka = k, kb = k + 1;
+    for (int j = 0; j < n; ++j) if (ht[j] >= ht[k] - half && ht[j] < ht[k] + half) { ka = std::min(ka, j); kb = std::max(kb, j + 1); }
+    Eigen::MatrixXd S = Eigen::MatrixXd::Zero(dim, dim);
+    for (int j = ka; j < kb; ++j) S = F[j] * S * F[j].transpose() + Q[j];
+    return Eigen::MatrixXd(S.block<6,6>(idxR, idxR));
+  };
+  {  // W1
+    for (double W : {0.004, 0.010, 0.0225, 0.040}) {
+      const auto b = relCovWindowBlocks(F, Q, ht, W, idxR);
+      double worst = 0.0;
+      for (int k = 0; k < n; ++k) worst = std::max(worst, (b[k] - indep(k, W)).norm());
+      CHECK(worst < 1e-12, "W1 window blocks equal independent forward simulation");
+    }
+  }
+  {  // W2
+    const auto b = relCovWindowBlocks(F, Q, ht, 1.0, idxR);
+    Eigen::MatrixXd S = Eigen::MatrixXd::Zero(dim, dim);
+    for (int j = 0; j < n; ++j) S = F[j] * S * F[j].transpose() + Q[j];
+    double worst = 0.0;
+    for (int k = 0; k < n; ++k) worst = std::max(worst, (b[k] - S.block<6,6>(idxR, idxR)).norm());
+    CHECK(worst < 1e-12, "W2 whole-scan window equals the full forward simulation for every k");
+  }
+  {  // W3
+    CHECK(relCovWindowBlocks(F, Q, ht, 0.0, idxR)[3].norm() == 0.0, "W3a window 0 gives zero blocks");
+    std::vector<double> bad(n - 1);
+    CHECK(relCovWindowBlocks(F, Q, bad, 0.01, idxR)[3].norm() == 0.0, "W3b size mismatch gives zero blocks");
+  }
+  {  // W4, W5, W6
+    StateGroup s;
+    s.cov_ = Eigen::MatrixXd::Identity(s.dimState(), s.dimState());
+    s.rot_ = Eigen::AngleAxisd(0.7, V3D(0.3, -0.5, 0.8).normalized()).toRotationMatrix();
+    const V3D p(1.3, -0.4, 2.1);
+    CHECK(s.windowCovAtPoint(p, 0.12).norm() == 0.0, "W4a window off returns exactly zero");
+    const double W = 0.0225;
+    auto b = relCovWindowBlocks(F, Q, ht, W, idxR);
+    s.setPointCovWindow(W);
+    CHECK(s.windowCovAtPoint(p, 0.12).norm() == 0.0, "W4b window on, empty profile returns zero");
+    s.setWindowCovProfile(ht, b);
+    const M3D ref0 = jbj(s.rot_, p, b[0]);
+    const M3D ref5 = jbj(s.rot_, p, b[5]);
+    const M3D refL = jbj(s.rot_, p, b[n - 1]);
+    CHECK((s.windowCovAtPoint(p, 0.0) - ref0).norm() < 1e-12, "W4c t before first head uses block 0");
+    CHECK((s.windowCovAtPoint(p, ht[5] + 0.5 * dt) - ref5).norm() < 1e-12, "W4d t inside step 5 uses block 5");
+    CHECK((s.windowCovAtPoint(p, ht[5]) - ref5).norm() < 1e-12, "W4e t equal to head 5 uses block 5");
+    CHECK((s.windowCovAtPoint(p, 9.0) - refL).norm() < 1e-12, "W4f t after last head uses the last block");
+    double asym = 0.0, mineig = 1e9;
+    for (int k = 0; k < n; ++k) {
+      asym = std::max(asym, (b[k] - b[k].transpose()).norm());
+      Eigen::SelfAdjointEigenSolver<M6> es(0.5 * (b[k] + b[k].transpose()));
+      mineig = std::min(mineig, es.eigenvalues().minCoeff());
+    }
+    CHECK(asym < 1e-14 && mineig > -1e-15, "W5 blocks symmetric and PSD");
+    const M3D before = s.windowCovAtPoint(p, ht[5]);
+    s.setRelCovProfile(ht, std::vector<M6>(n, 1e3 * M6::Identity()));
+    CHECK((s.windowCovAtPoint(p, ht[5]) - before).norm() == 0.0, "W6 independent of the R65 profile");
+  }
+  std::printf("ALL PASS\n");
+  return 0;
+}
