-PlaneFit fitIncrementalPca(const PlaneStats& s, double max_ratio) {
-  ValidityRule r;
-  r.plane_eig_max = std::numeric_limits<double>::infinity();
-  r.min_secondary_eig = -std::numeric_limits<double>::infinity();
-  r.max_planarity = max_ratio;
-  return fitPlane(s, r);
-}
