-  };
-  // Lc(A) = sum_i (A z_i)^T C_i n = sum_{a,c,d} A(c,a) n_d U[a](c,d)
-  auto Lc = [&](const M3& A) {
-    double q = 0.0;
-    for (int a = 0; a < 3; ++a)
-      for (int c = 0; c < 3; ++c)
-        for (int d = 0; d < 3; ++d) q += A(c, a) * n[d] * U[a](c, d);
-    return q;
-  };
-  out = M3::Zero();
-  out(0, 0) = Q(A1, A1) / (N * N * d1 * d1);
-  out(1, 1) = Q(A2, A2) / (N * N * d2 * d2);
-  out(0, 1) = out(1, 0) = Q(A1, A2) / (N * N * d1 * d2);
