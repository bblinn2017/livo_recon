<launch>
  <arg name="rviz" default="true" />
  <!-- 2026-10-20: added to match every other dataset's launch file (ntu_viral, slam_2022/2023,
       slam_2023_robot): this file never had an overrides_file arg, so run_one()'s own
       per-job overrides_file (including the all-important common/offline_bag_path that
       switches the node into runOffline() instead of run()) were silently never loaded. A
       mid360 job always fell through to live ROS mode (ros::spinOnce(), nothing ever
       arriving since no rosbag play/live sensor is running) regardless of its own job.env/
       config.yaml. Test-only escape hatch: a rosparam file loaded LAST (after
       config/mid360.yaml below), so a real override file passed via
       overrides_file:=/path/to/file.yaml always wins without editing the checked-in config.
       Defaults to a real, empty, valid-YAML no-op file so normal/default runs are unaffected. -->
  <arg name="overrides_file" default="$(find livo_recon)/config/mid360_no_overrides.yaml" />
  <arg name="base_config_file" default="$(find livo_recon)/config/mid360.yaml" />

  <node pkg="livo_recon"
        type="livo_recon_node"
        name="livo_recon"
        output="screen">
    <!-- 2026-08-16: consolidated from config/defaults/*.yaml + config/
         mid360/*.yaml (~22 separate files) into one self-contained
         config/mid360.yaml, see that file's own header comment -->
    <rosparam file="$(arg base_config_file)" command="load" />
    <rosparam file="$(arg overrides_file)"                    command="load" />
    <!-- viz/enable follows the rviz arg directly, placed after every
         rosparam load above (including dataset specific viz.yaml overrides,
         see mid360's), so it always wins: no rviz window means livo_recon's
         own visualization computation/publishing (point cloud, image, etc,
         see pub_processing.cpp) is skipped too, not just the rviz process
         itself. -->
    <param name="viz/enable" value="$(arg rviz)" />
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find livo_recon)/rviz_cfg/livo_recon.rviz" />
  </group>
</launch>
